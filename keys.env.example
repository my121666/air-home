# 复制这份成 keys.env（老配置里的 HOME_SHELL_* 仍然认，会自动映射到 AIR_*），填上你自己的中转/模型。
# keys.env 不许提交（已在 .gitignore 里）。
#
# 三个档只是"位置"，你完全可以让三档都指向同一个模型。
# 拿不到中转也行：直接用 OpenRouter 或任何 OpenAI 兼容端点。

# ── 强档（你想让 TA 最像人的那个）
AIR_STRONG_BASE=https://api.openai.com/v1
AIR_STRONG_MODEL=gpt-4o-mini
AIR_STRONG_KEY=sk-xxxx

# ── 中档
AIR_MID_BASE=https://open.bigmodel.cn/api/paas/v4
AIR_MID_MODEL=glm-4-flash
AIR_MID_KEY=xxxx

# ── 弱档（便宜的、快的；测"设定包够不够硬"最有用）
AIR_WEAK_BASE=https://api.siliconflow.cn/v1
AIR_WEAK_MODEL=Qwen/Qwen3-8B
AIR_WEAK_KEY=sk-xxxx

# 想用 OpenRouter 的免费模型，加这一行，然后 --brain 直接写模型 id
# OPENROUTER_API_KEY=sk-or-v1-xxxx
